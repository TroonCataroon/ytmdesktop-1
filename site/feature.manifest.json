{
  "id": "ytmd.install-surface",
  "version": "1.0.0",
  "title": "YTMD Install Surface",
  "description": "Composable web install wizard: OS detection, GitHub Release download links, and guided setup for Electron Forge installers (Squirrel Setup.exe, macOS ZIP, Linux deb/rpm). Does not host the Electron main process.",
  "kind": "web-feature",
  "entry": {
    "register": "./register.js",
    "routes": [
      {
        "path": "/",
        "file": "./index.html"
      }
    ]
  },
  "events": {
    "publish": ["install.wizard.step", "install.wizard.download"],
    "subscribe": []
  },
  "dependencies": {
    "releases": {
      "provider": "github",
      "owner": "TroonCataroon",
      "repo": "ytmdesktop-1",
      "channel": "latest"
    },
    "desktop": {
      "packager": "electron-forge",
      "makers": ["squirrel", "zip", "deb", "rpm"]
    }
  }
}
